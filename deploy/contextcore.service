[Unit]
Description=ContextCore MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=contextcore
Group=contextcore
WorkingDirectory=/opt/contextcore/code
Environment=NM_STATE=/opt/contextcore/state
Environment=PORT=8798
Environment=HOST=127.0.0.1
Environment=GIT_BACKUP=1
ExecStart=/usr/bin/node server/server.mjs
Restart=always
RestartSec=3
# note search by meaning keeps a small embedding model in memory (~0.6 GB); Environment=SEARCH=0 turns it off
MemoryMax=1600M

[Install]
WantedBy=multi-user.target
